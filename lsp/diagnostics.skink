// Module diagnostics provides type-checking diagnostics for the LSP server.
//
// It runs the Skink checker on a document and converts errors into LSP
// Diagnostic objects. It also performs lightweight lexical analysis to catch
// syntax errors before the full checker runs.
module diagnostics

import "std/json"
import "std/str"
import "std/lexer"
import "std/resolver"
import "std/checker"
import "std/ast"
import "std/fs"
import "lsp/documents"

// tempCounter is a module-level counter used to generate unique temp-file
// names for type-checking. This prevents two concurrent checkTypes calls
// (e.g. for two files in the same directory) from racing on the same path.
var tempCounter int = 0

// check runs the Skink checker on the document with the given URI and
// returns an array of LSP Diagnostic JSON values.
pub fn check(dm: *documents.DocumentManager, uri: string, skinkHome: string) -> json.Value {
    text, ok := documents.getText(dm, uri)
    if !ok {
        return json.FromArray([]json.Value{})
    }

    var diags []json.Value

    // Phase 1: Lexical analysis — catch lexer errors and basic syntax issues
    lexDiags := checkLexical(text)
    for i := 0; i < len(lexDiags); i = i + 1 {
        diags = append(diags, lexDiags[i])
    }

    // Phase 2: Full type-checking via the Skink checker
    typeDiags := checkTypes(text, uri, skinkHome)
    for i := 0; i < len(typeDiags); i = i + 1 {
        diags = append(diags, typeDiags[i])
    }

    if len(diags) == 0 {
        return json.FromArray([]json.Value{})
    }
    return json.FromArray(diags)
}

// checkFast runs only the lexical/syntax pass on a document and returns an
// array of LSP Diagnostic JSON values. Unlike check(), it never invokes the
// resolver or type checker, so it returns in milliseconds even for files that
// import the compiler's own heavy modules (checker/resolver/ast — a full check
// of those takes tens of seconds to minutes of CPU). It is used on the
// didOpen/didChange path so that editing never starves completion, hover, and
// other requests queued behind a slow type check.
pub fn checkFast(dm: *documents.DocumentManager, uri: string) -> json.Value {
    text, ok := documents.getText(dm, uri)
    if !ok {
        return json.FromArray([]json.Value{})
    }
    return json.FromArray(checkLexical(text))
}

// checkLexical performs lightweight lexical analysis to catch basic syntax
// errors without running the full type checker.
fn checkLexical(text: string) -> []json.Value {
    var diags []json.Value
    tokens := lexer.Tokenize(text)

    // Check for unterminated strings
    for i := 0; i < len(tokens); i = i + 1 {
        tok := tokens[i]
        if tok.kind == lexer.T_ILLEGAL {
            msg := str.Concat("illegal token: ", tok.literal)
            diag := makeDiagnostic(tok.line - 1, tok.col - 1, tok.line - 1, tok.col, msg, 1, "syntax")
            diags = append(diags, diag)
        }
    }

    // Check for unmatched braces/brackets/parens
    braceDepth := 0
    bracketDepth := 0
    parenDepth := 0
    for i := 0; i < len(tokens); i = i + 1 {
        tok := tokens[i]
        if tok.kind == lexer.T_LBRACE {
            braceDepth = braceDepth + 1
        } else if tok.kind == lexer.T_RBRACE {
            braceDepth = braceDepth - 1
            if braceDepth < 0 {
                diag := makeDiagnostic(tok.line - 1, tok.col - 1, tok.line - 1, tok.col, "unexpected closing brace '}'", 1, "syntax")
                diags = append(diags, diag)
            }
        } else if tok.kind == lexer.T_LBRACKET {
            bracketDepth = bracketDepth + 1
        } else if tok.kind == lexer.T_RBRACKET {
            bracketDepth = bracketDepth - 1
            if bracketDepth < 0 {
                diag := makeDiagnostic(tok.line - 1, tok.col - 1, tok.line - 1, tok.col, "unexpected closing bracket ']'", 1, "syntax")
                diags = append(diags, diag)
            }
        } else if tok.kind == lexer.T_LPAREN {
            parenDepth = parenDepth + 1
        } else if tok.kind == lexer.T_RPAREN {
            parenDepth = parenDepth - 1
            if parenDepth < 0 {
                diag := makeDiagnostic(tok.line - 1, tok.col - 1, tok.line - 1, tok.col, "unexpected closing parenthesis ')'", 1, "syntax")
                diags = append(diags, diag)
            }
        }
    }

    if braceDepth > 0 {
        diag := makeDiagnostic(0, 0, 0, 1, str.Concat("unmatched opening brace(s): ", intStr(braceDepth)), 1, "syntax")
        diags = append(diags, diag)
    }
    if bracketDepth > 0 {
        diag := makeDiagnostic(0, 0, 0, 1, str.Concat("unmatched opening bracket(s): ", intStr(bracketDepth)), 1, "syntax")
        diags = append(diags, diag)
    }
    if parenDepth > 0 {
        diag := makeDiagnostic(0, 0, 0, 1, str.Concat("unmatched opening parenthesis(s): ", intStr(parenDepth)), 1, "syntax")
        diags = append(diags, diag)
    }

    return diags
}

// checkTypes runs the full Skink type checker on the document.
// It writes the document text to a temporary file in the same directory
// (so import resolution works correctly), runs the resolver + checker,
// and converts checker errors into LSP diagnostics.
fn checkTypes(text: string, uri: string, skinkHome: string) -> []json.Value {
    var diags []json.Value

    // Convert URI to file path
    filePath := documents.uriToPath(uri)

    // Write the document text to a temp file in the SAME directory as the
    // source file. The resolver derives import search paths from the file's
    // directory (dirName), so the temp file must be co-located for imports
    // to resolve correctly. We use a ".lspcheck" extension (not .skink) so
    // the file watcher in the extension (**/*.skink) doesn't pick it up and
    // trigger a feedback loop.
    //
    // The filename includes a per-process counter so that two concurrent
    // checks of files in the same directory don't race on the same path.
    // If the source directory is read-only (common for library code in
    // /usr/local/lib), writeFile fails and we return no type diagnostics
    // rather than silently writing to the wrong location.
    dir := dirOf(filePath)
    tempCounter = tempCounter + 1
    tmpFile := joinPath(dir, str.Concat(str.Concat(".skink_lsp_check_", intStr(tempCounter)), ".lspcheck"))
    if !writeFile(tmpFile, text) {
        return diags
    }

    // Run the resolver to load and parse the file and its imports.
    // Resolve returns (decls, errors) — we must capture BOTH. Parser and
    // import-resolution errors come back here; if we only take decls they
    // are silently dropped and the user sees no diagnostics at all.
    decls, resolveErrs := resolver.Resolve(tmpFile, skinkHome)

    // Clean up the temp file
    removeFile(tmpFile)

    // Convert resolver/parser errors into diagnostics first. These include
    // syntax errors caught by the parser (e.g. "unexpected token", "expected }")
    // and import-resolution errors. We report them even when decls is empty,
    // so the user sees syntax errors immediately while typing.
    for i := 0; i < len(resolveErrs); i = i + 1 {
        line, col, msg := parseCheckerError(resolveErrs[i])
        diag := makeDiagnostic(line, col, line, col + 1, msg, 1, "syntax")
        diags = append(diags, diag)
    }

    if len(decls) == 0 {
        return diags
    }

    // Run the type checker
    c := checker.newChecker()
    ok := checker.checkProgram(&c, decls)
    if !ok {
        errs := checker.Errors(&c)
        for i := 0; i < len(errs); i = i + 1 {
            line, col, msg := parseCheckerError(errs[i])
            diag := makeDiagnostic(line, col, line, col + 1, msg, 1, "type")
            diags = append(diags, diag)
        }
    }

    return diags
}

// dirOf returns the directory portion of a file path (everything up to the
// last '/'). If there is no '/', returns ".".
fn dirOf(p: string) -> string {
    idx := lastSlash(p)
    if idx < 0 {
        return "."
    }
    return str.Substr(p, 0, idx)
}

// lastSlash returns the index of the last '/' in p, or -1 if none.
fn lastSlash(p: string) -> int {
    i := str.Len(p) - 1
    for i >= 0 {
        if p[i] == 47 { // '/'
            return i
        }
        i = i - 1
    }
    return -1
}

// joinPath joins a directory and file name with a '/' separator.
fn joinPath(dir: string, name: string) -> string {
    if str.Len(dir) == 0 || str.Equal(dir, ".") {
        return name
    }
    if dir[str.Len(dir) - 1] == 47 { // ends with '/'
        return str.Concat(dir, name)
    }
    return str.Concat(str.Concat(dir, "/"), name)
}

// removeFile deletes a file from disk. Errors are silently ignored.
fn removeFile(path: string) {
    fs.Remove(path)
}

// parseCheckerError parses an error string of the form
// "filePath line:col: message" (or "line:col: message" when no file prefix)
// and returns the 0-based line, 0-based column, and message.
//
// The checker emits errors as "<file> <line>:<col>: <msg>" (see
// std/checker.skink report/reportAt). The file path is separated from
// the line number by a single space, so the line number is the digit run
// immediately before the first colon, bounded on the left by a non-digit
// character (the space). This works even when the path itself contains
// digits (e.g. "/foo_v2/bar.skink 12:3: msg") because the space breaks
// the digit run.
fn parseCheckerError(errStr: string) -> (int, int, string) {
    // Find the first colon — it separates line from col.
    colon1 := str.IndexOf(errStr, ":")
    if colon1 < 0 {
        return 0, 0, errStr
    }

    // The line number is the digits immediately before colon1. Walk backwards
    // from colon1 to find where the digit run starts. The char before the
    // digit run must be a non-digit (a space when a file path is present, or
    // the start of the string when no path is present). This correctly
    // separates the line number from any file-path prefix that ends in a
    // digit, because the path-line separator is always a space.
    lineStart := colon1
    for lineStart > 0 {
        c := int(errStr[lineStart - 1])
        if c >= 48 && c <= 57 {
            lineStart = lineStart - 1
        } else {
            break
        }
    }
    // If the char before the digit run is not a space and not the start of
    // the string, the colon we found is not a line:col separator (it may be
    // part of the file path on Windows, or a malformed error string). In
    // that case, bail out and return the raw string.
    if lineStart > 0 {
        prevChar := int(errStr[lineStart - 1])
        if prevChar != 32 { // not a space
            return 0, 0, errStr
        }
    }
    lineStr := str.Substr(errStr, lineStart, colon1 - lineStart)

    // Find the second colon — it separates col from the message.
    colon2 := str.IndexOf(str.Substr(errStr, colon1 + 1, str.Len(errStr) - colon1 - 1), ":")
    if colon2 < 0 {
        return 0, 0, errStr
    }
    colon2 = colon1 + 1 + colon2

    colStr := str.Substr(errStr, colon1 + 1, colon2 - colon1 - 1)
    msg := str.Substr(errStr, colon2 + 1, str.Len(errStr) - colon2 - 1)
    msg = str.Trim(msg)

    line := parseInt(lineStr) - 1  // Convert to 0-based
    col := parseInt(colStr) - 1
    if line < 0 {
        line = 0
    }
    if col < 0 {
        col = 0
    }

    // lineStr and colStr are RC-managed (allocated by str.Substr via
    // Skink_mem_alloc). Do not call libc.free on them — the RC system
    // reclaims them when their refcount drops to zero. Calling libc.free
    // on an RC-managed pointer bypasses the RCHeader and corrupts the
    // heap (the payload pointer is offset from the malloc'd base by
    // RC_PREFIX_SIZE).
    return line, col, msg
}

// parseInt parses a decimal integer string, returning 0 on failure.
fn parseInt(s: string) -> int {
    result := 0
    for i := 0; i < str.Len(s); i = i + 1 {
        c := int(s[i])
        if c >= 48 && c <= 57 {
            result = result * 10 + (c - 48)
        }
    }
    return result
}

// intStr converts an integer to a string.
fn intStr(n: int) -> string {
    if n == 0 {
        return "0"
    }
    neg := false
    if n < 0 {
        neg = true
        n = -n
    }
    result := ""
    for n > 0 {
        d := n % 10
        result = str.Concat(charForDigit(d), result)
        n = n / 10
    }
    if neg {
        result = str.Concat("-", result)
    }
    return result
}

fn charForDigit(d: int) -> string {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// makeDiagnostic creates an LSP Diagnostic JSON object.
// severity: 1=Error, 2=Warning, 3=Information, 4=Hint
fn makeDiagnostic(startLine: int, startChar: int, endLine: int, endChar: int, message: string, severity: int, source: string) -> json.Value {
    start := json.FromObject([]string{"line", "character"}, []json.Value{json.FromNumber(float(startLine)), json.FromNumber(float(startChar))})
    end := json.FromObject([]string{"line", "character"}, []json.Value{json.FromNumber(float(endLine)), json.FromNumber(float(endChar))})
    rangeVal := json.FromObject([]string{"start", "end"}, []json.Value{start, end})
    return json.FromObject([]string{"range", "severity", "message", "source"}, []json.Value{rangeVal, json.FromNumber(float(severity)), json.FromString(message), json.FromString(source)})
}

// writeFile writes text to a file at the given path.
// Returns true on success, false on failure.
fn writeFile(path: string, text: string) -> bool {
    f, err := fs.Open(path, "w")
    if err.message != "" {
        return false
    }
    f.Write(text, str.Len(text))
    f.Close()
    return true
}









